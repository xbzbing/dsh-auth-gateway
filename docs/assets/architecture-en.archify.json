  "cards": [
    {
      "dot": "cyan",
      "title": "Auth flow",
      "items": [
        "First boot mints a one-time initial password; onboarding forces a personal one",
        "Optional TOTP: mainstream authenticators + one-time backup codes",
        "Unauthenticated API 401, pages 302, WebSocket upgrade rejected"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data & observability",
      "items": [
        "password.json scrypt-hashed; otp.json AES-256-GCM sealed",
        "audit.log JSONL, daily rotation, 90-day retention, deduped failure alerts",
        "Brute-force alerts also broadcast the dsh-auth-gateway/brute-force event"
      ]
    },
    {
      "dot": "rose",
      "title": "Security foundation",
      "items": [
        "Bundle patch pins the internal webserver to 127.0.0.1:<N+1>",
        "Remote clients cannot bypass the gateway to reach the backend",
        "Sessions are in-memory 256-bit tokens; password change revokes all"
      ]
    }
